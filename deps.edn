{:paths ["src"]
 ;; Standalone / zero-external-dep at the kernel layer (ADR-2607176501 /
 ;; ADR-2607011000 fleet standalone convention). The pure system-dynamics +
 ;; Governor + charter kernels depend only on clojure.core, so the pure-kernel
 ;; :test and :lint run with no fleet :local/root deps.
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}}

 :aliases
 {;; Phase-2 composition deps (langgraph-clj StateGraph + langchain.db :db-api
  ;;  store + langchain-store + ed25519/ipns for the CACAO identity). NOT
  ;;  required by the pure-kernel :test path. langgraph-clj is at the canonical
  ;;  fleet path orgs/kotoba-lang/langgraph. The :override-deps pins langgraph's
  ;;  transitive langchain dep to the local checkout so no network is needed.
  :dev {:override-deps {io.github.kotoba-lang/langchain
                        {:local/root "../../kotoba-lang/langchain"}}
        :extra-deps {io.github.com-junkawasaki/langgraph-clj
                     {:local/root "../../kotoba-lang/langgraph"}
                     io.github.com-junkawasaki/langchain-clj
                     {:local/root "../../kotoba-lang/langchain"}
                     io.github.kotoba-lang/langchain-store
                     {:local/root "../../kotoba-lang/langchain-store"}
                     io.github.kotoba-lang/ed25519
                     {:local/root "../../kotoba-lang/ed25519"}
                     io.github.kotoba-lang/ipns
                     {:local/root "../../kotoba-lang/tech-ipfs-specs-ipns"}
                     org.clojure/data.json {:mvn/version "2.5.1"}}}

  ;; static analysis — clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}

  ;; pure-kernel test runner (no fleet deps required).
  :test {:extra-paths ["test"]
         :main-opts    ["-m" "oteint.test-runner"]}

  ;; Phase-2 end-to-end: pure kernels + langgraph StateGraph + langchain-store
  ;; :db-api store + murakumo-main advisor + CACAO identity. `clojure -M:phase2`.
  :phase2 {:extra-paths ["test"]
           :override-deps {io.github.kotoba-lang/langchain
                           {:local/root "../../kotoba-lang/langchain"}}
           :extra-deps {io.github.com-junkawasaki/langgraph-clj
                        {:local/root "../../kotoba-lang/langgraph"}
                        io.github.com-junkawasaki/langchain-clj
                        {:local/root "../../kotoba-lang/langchain"}
                        io.github.kotoba-lang/langchain-store
                        {:local/root "../../kotoba-lang/langchain-store"}
                        io.github.kotoba-lang/ed25519
                        {:local/root "../../kotoba-lang/ed25519"}
                        io.github.kotoba-lang/ipns
                        {:local/root "../../kotoba-lang/tech-ipfs-specs-ipns"}
                        org.clojure/data.json {:mvn/version "2.5.1"}}
           :main-opts ["-m" "oteint.dev-test-runner"]}

  ;; CACAO identity tool: generate/load .oteint/identity.edn, print did + graph.
  ;; `clojure -M:identity show oteint`. Seed stays gitignored.
  :identity {:extra-deps {io.github.kotoba-lang/ed25519
                          {:local/root "../../kotoba-lang/ed25519"}
                          io.github.kotoba-lang/ipns
                          {:local/root "../../kotoba-lang/tech-ipfs-specs-ipns"}}
             :main-opts ["-m" "oteint.identity"]}}}
