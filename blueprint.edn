{:oteint.blueprint/id "com-etzhayyim-oteint"
 :oteint.blueprint/name "おてんとさま (Otentosama) — all-seeing sun: system-dynamics activity loop for cybercrime actor attribution"
 :oteint.blueprint/domain :security/threat-attribution
 :oteint.blueprint/governor :attribution-governor
 :oteint.blueprint/metaphor "太陽は照らす、裁かない — the sun observes+records; a separate lineage (Governor) judges"
 :oteint.blueprint/topology "OTEINT-AR ⊣ AttributionGovernor"
 :oteint.blueprint/sibling "tadori (辿) — chartered on-chain transaction→actor attribution; oteint is the behavioral-activity-plane sibling (distinct data plane, same governance bar)"
 :oteint.blueprint/required-technologies [:identity :audit-ledger :system-dynamics :governor :case-mandate]
 :oteint.blueprint/maturity :blueprint
 :oteint.blueprint/rad-repo "github.com/etzhayyim/com-etzhayyim-oteint"
 :oteint.blueprint/rad-did-web "did:web:etzhayyim.github.io:com-etzhayyim-oteint"
 :oteint.blueprint/adr "adr-2607182000-com-etzhayyim-oteint-attribution-actor"
 :oteint.blueprint/stocks ["suspicion" "evidence" "coherence" "exposure-cost"]
 :oteint.blueprint/flows ["inflow-suspicion" "decay-suspicion" "coherence-easing" "fp-correction-outflow"]
 :oteint.blueprint/loops [:R1-reinforcing-bounded :B1-false-positive-guard :B2-proportionality :B3-evidence-expiry]
 :oteint.blueprint/governor-invariants [:closed-allowlist :evidence-floor :coherence-floor
                                        :false-positive-guard :proportionality-audit :disclosure-guard]
 ;; Governance posture — mirrors tadori (辿), the chartered actor-attribution actor.
 :oteint.blueprint/charter-posture "G3 authorized-investigation-only / G7 evidence-only-no-enforcement / tsukuroi propose-only (ADR-2605291500) / caseMandate required — no valid case ⇒ Phase 0 dry-run"
 :oteint.blueprint/zero-counters [:noncase-write :plaintext-pii :proprietary-sor :enforcement-action
                                  :platform-held-key :murakumo-bypass :mass-surveillance :adherent-deanon :non-kotoba-store]
 :oteint.blueprint/g12 "any nonzero zero-counter ⇒ HALT, persist nothing"
 :oteint.blueprint/autonomous-act "self-audit heartbeat ONLY (silenOteintReview) — never autonomous live attribution"
 ;; Defensive scope (safety floor). This actor NEVER does these.
 :oteint.blueprint/never #{:mass-surveillance :public-doxxing :vigilante-action :law-enforcement-direct-action
                           :self-authorized-block :subject-contact :autonomous-live-attribution}}
